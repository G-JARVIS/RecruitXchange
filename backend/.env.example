# ============================================================
# RecruitXchange Backend — Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# --- Server ---
NODE_ENV=development
PORT=5000

# --- MongoDB ---
# Atlas (production): mongodb+srv://<user>:<pass>@cluster0.xxxx.mongodb.net/recruitxchange?retryWrites=true&w=majority
# Local (development): mongodb://localhost:27017/recruitxchange
MONGODB_URI=mongodb://localhost:27017/recruitxchange

# --- JWT ---
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRE=7d
JWT_COOKIE_EXPIRE=7

# --- Frontend URL (CORS) ---
FRONTEND_URL=http://localhost:5173

# --- Cloudinary (for resume/profile image upload) ---
# Leave blank to use local disk storage fallback
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Google OAuth ---
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# --- Judge0 (Code Execution) ---
# Leave blank to use mock execution
JUDGE0_API_URL=https://judge0-ce.p.rapidapi.com
JUDGE0_API_KEY=your_rapidapi_key

# --- Rate Limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
